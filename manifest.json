{
    "name": "DOM Memo Capture",
    "description": "Select DOM elements and capture them with memos to markdown files",
    "version": "1.0.2",
    "manifest_version": 3,
    "permissions": [
        "activeTab",
        "scripting",
        "downloads",
        "storage",
        "sidePanel"
    ],
    "action": {
        "default_title": "DOM Memo Capture"
    },
    "side_panel": {
        "default_path": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "css": ["content.css"]
        }
    ]
}